# Copy to .env and fill in real values. Never commit .env itself.

# Postgres
POSTGRES_PASSWORD=

# Backend auth
SECRET_KEY=
INITIAL_ADMIN_PASSWORD=
# Set to true in production (HTTPS) so the session cookie requires TLS
COOKIE_SECURE=false

# CORS — comma-separated list of allowed frontend origins, no trailing slash
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend origin (used for CORS + links in emails/WhatsApp messages)
FRONTEND_URL=http://localhost:5173

# Backend's own public origin — only needed when frontend and backend are
# served from different domains (e.g. production). Prefixes /api/uploads/...
# URLs (vehicle photos, reservation attachments) so they resolve correctly
# from a frontend on a different domain. Leave empty for local dev.
PUBLIC_BACKEND_URL=

# Google Calendar sync — see backend/scripts/gcal_auth.py for how to obtain these
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_PROSPECTOS=
GOOGLE_CALENDAR_PENDIENTE=
GOOGLE_CALENDAR_ABONO=
GOOGLE_CALENDAR_OK=
GOOGLE_CALENDAR_OBSEQUIO=
GOOGLE_CALENDAR_PUBLICIDAD=
GOOGLE_CALENDAR_CANCELADOS=
GOOGLE_CALENDAR_CLIENTES=
GOOGLE_CALENDAR_PRERESERVA=
GOOGLE_CALENDAR_TEAM=

# Claude API — AI chat assistant on the public site (leave empty to hide it)
ANTHROPIC_API_KEY=
AI_ASSISTANT_MODEL=claude-haiku-4-5
AI_ASSISTANT_MAX_TOKENS=500
AI_ASSISTANT_MAX_TURNS_PER_SESSION=20
AI_ASSISTANT_DAILY_MESSAGE_BUDGET=300
AI_ASSISTANT_CONSECUTIVE_ERROR_THRESHOLD=3

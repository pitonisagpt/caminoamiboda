{
  // Static-assets deploy for Cloudflare Workers, with a thin Worker script
  // in front of it (worker.ts) that ONLY does anything for link-preview
  // bots hitting /catalogo or /en/catalogo?vehiculo=<id> — see worker.ts.
  // Every other request still gets served by the assets binding exactly as
  // before. Explicit config on purpose: wrangler's auto-detection for Vite
  // projects requires Vite 6+, and this repo is on Vite 5 — bypassing
  // auto-detect avoids that version gate entirely. Because `main` and
  // `assets` are both fully explicit here, adding `main` does not
  // reintroduce that auto-detection gotcha either.
  "name": "caminoamiboda",
  "compatibility_date": "2026-08-31",
  "main": "worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, a request for "/" matches dist/index.html literally and
    // is served straight from the assets binding, bypassing worker.ts
    // entirely — including its preventEdgeCachingOfHtml() override, which
    // is exactly what let index.html get stuck stale at Cloudflare's edge
    // after a deploy. `true` (not scoped to specific paths) so every
    // request — "/" included — goes through the Worker; the JS/CSS/image
    // assets that don't strictly need this still hit
    // preventEdgeCachingOfHtml(), which no-ops for anything that isn't
    // text/html, so their own caching is untouched.
    "run_worker_first": true
  },
  "vars": {
    "API_BASE_URL": "https://api.caminoamiboda.com"
  }
}

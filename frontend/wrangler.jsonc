{
  // Static-assets deploy for Cloudflare Workers, with a thin Worker script
  // in front of it (worker.ts) that ONLY does anything for link-preview
  // bots hitting /catalogo or /en/catalogo?vehiculo=<id> — see worker.ts.
  // Every other request still gets served by the assets binding exactly as
  // before. Explicit config on purpose: wrangler's auto-detection for Vite
  // projects requires Vite 6+, and this repo is on Vite 5 — bypassing
  // auto-detect avoids that version gate entirely. Because `main` and
  // `assets` are both fully explicit here, adding `main` does not
  // reintroduce that auto-detection gotcha either.
  "name": "caminoamiboda",
  "compatibility_date": "2026-08-31",
  "main": "worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "API_BASE_URL": "https://api.caminoamiboda.com"
  }
}
